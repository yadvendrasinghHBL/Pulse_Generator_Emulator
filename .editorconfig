# Editor settings for every editor that supports EditorConfig (Zed, VS Code, CLion, vim, ...).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,ld}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[Drivers/**]
# vendored ST code: keep as shipped
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
