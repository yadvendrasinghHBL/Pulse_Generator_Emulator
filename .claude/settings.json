{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake --preset *)",
      "Bash(cmake --build --preset debug)",
      "Bash(cmake --build --preset release)",
      "Bash(tools/build_all.sh *)",
      "Bash(tools/build_all.sh)",
      "Bash(tools/con_send.sh *)",
      "Bash(~/.venvs/bringup/bin/python tools/pulse_test.py)",
      "Bash(ls /dev/ttyUSB*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
